      "topic": "Linear Equations",
      "questionType": "MCQ",
      "difficulty": "Easy",
      "marks": 2,
      "questionText": "Solve for x in the equation 3x + 7 = 22.",
      "options": [
        "x = 3",
        "x = 5",
        "x = 7",
        "x = 15"
      ],
      "correctAnswer": "x = 5",
